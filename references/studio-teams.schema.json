                    "objective": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/goal"
                    },
                    "completionCriteria": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/goal"
                    },
                    "position": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
