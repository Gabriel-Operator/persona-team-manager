                            "completion": {
                              "type": "object",
                              "properties": {
                                "operationId": {
                                  "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                                },
                                "values": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                                  },
                                  "default": {}
                                },
                                "statePath": {
                                  "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                                },
                                "success": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "minItems": 1
                                },
                                "failure": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "default": []
                                },
                                "intervalSeconds": {
                                  "type": "integer",
                                  "minimum": 15,
                                  "maximum": 3600,
                                  "default": 60
                                },
                                "deadlineSeconds": {
                                  "type": "integer",
                                  "minimum": 30,
                                  "maximum": 604800
                                }
                              },
                              "required": [
                                "operationId",
                                "statePath",
                                "success",
                                "deadlineSeconds"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "requirementId",
                            "operationId",
                            "effect"
                          ],
                          "additionalProperties": false
                        },
                        "playbookKey": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "inputMappings": {
                          "type": "object",
                          "additionalProperties": {
                            "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                          },
                          "default": {}
                        },
                        "outputFields": {
                          "type": "object",
                          "additionalProperties": {
                            "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                          },
                          "default": {}
                        },
                        "waitUntil": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                        },
                        "requiresApproval": {
                          "type": "boolean",
                          "default": false
                        },
                        "publication": {
                          "type": "object",
                          "properties": {
                            "target": {
                              "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                            },
                            "fields": {
                              "type": "object",
                              "additionalProperties": {
                                "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                              }
                            },
                            "recordId": {
                              "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                            },
                            "expectedUpdatedAt": {
                              "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                            }
                          },
                          "required": [
                            "target",
                            "fields"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "instruction",
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "schemaVersion",
                  "key",
                  "name",
                  "revision",
                  "kind",
                  "steps"
