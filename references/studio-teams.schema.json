                    "meetingCycle": {
                      "type": "object",
                      "properties": {
                        "researcher": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "caller": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "scribe": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "analyst": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "steward": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "publisher": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                        },
                        "prepareMinutes": {
                          "type": "number",
                          "const": 30,
                          "default": 30
                        },
                        "lookbackDays": {
                          "type": "number",
                          "const": 90,
                          "default": 90
                        },
                        "maxCallSeconds": {
                          "type": "number",
                          "const": 180,
                          "default": 180
                        },
                        "signalRules": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                              },
                              "field": {
                                "type": "string",
                                "maxLength": 1000
