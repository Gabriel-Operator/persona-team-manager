                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "playbookId",
                    "sourceFingerprint",
                    "name",
                    "objective",
                    "completionCriteria",
                    "position"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 64
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                    },
                    "sourceBotId": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                    },
                    "targetBotId": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                    },
                    "pageId": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "delegate",
                        "handoff",
                        "update_page"
                      ]
