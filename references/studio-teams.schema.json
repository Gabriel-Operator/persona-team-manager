                "properties": {
                  "teamId": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/teamId"
                  },
                  "schemaVersion": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/schemaVersion"
                  },
                  "key": {
                    "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                  },
                  "name": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/name"
                  },
                  "revision": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/revision"
                  },
                  "inputs": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/inputs"
                  },
                  "requirements": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/requirements"
                  },
                  "outputFields": {
                    "$ref": "#/definitions/StudioTeams/properties/playbooks/items/anyOf/0/properties/outputFields"
                  },
                  "kind": {
                    "type": "string",
                    "const": "goal"
                  },
                  "objective": {
                    "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/goal"
                  },
                  "completionCriteria": {
                    "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/goal"
                  },
                  "allowedSkills": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                    },
                    "maxItems": 30,
                    "default": []
