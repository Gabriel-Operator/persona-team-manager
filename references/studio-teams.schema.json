                  "limits": {
                    "type": "object",
                    "properties": {
                      "maxDepth": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3,
                        "default": 3
                      },
                      "maxAgents": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 12,
                        "default": 12
