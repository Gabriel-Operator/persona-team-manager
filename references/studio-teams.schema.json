                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "instruction": {
                          "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/goal"
                        },
                        "dependsOn": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                          },
                          "maxItems": 32,
                          "default": []
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "reason",
                            "connector_operation",
                            "playbook",
                            "wait_until",
                            "publish_page",
                            "publish_list"
