                              "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
                            },
                            "expectedRevision": {
                              "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/automationPolicies/items/properties/meetingCycle/properties/signalRules/items/properties/field"
