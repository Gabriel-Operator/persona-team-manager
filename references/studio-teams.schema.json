{
  "$ref": "#/definitions/StudioTeams",
  "definitions": {
    "StudioTeams": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
