                    },
                    "intervalMinutes": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 1440
                    },
                    "maxCredits": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "maxModelCalls": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128
                    },
                    "sharedFields": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/StudioTeams/properties/teams/items/properties/id"
                      },
                      "maxItems": 100,
                      "default": []
