                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "budget": {
                "type": "object",
                "properties": {
                  "dailyCredits": {
                    "type": "number",
                    "minimum": 0
                  },
                  "episodeCredits": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "dailyCredits",
                  "episodeCredits"
                ],
                "additionalProperties": false
